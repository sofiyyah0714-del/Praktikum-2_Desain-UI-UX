<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Document</title>
</head>
<body>
    <h1>Black goese bistro | Pizza-on-Demand</h1>
    <p>
      our 12&quet; wood-fired pizzas are available for delivery.
    </p>
    
    <form action="http://www.blackgoosebistro.com/pizza.php" method="post">
      <fieldset>
        <legend> your information</legend>
        <p> 
        <label for="name">Name:</label>
        <input type="text" id="name" name="name">
        </p>
        
                <p> 
        <label for="address">Address:</label>
        <input type="address" id="address" name="address">
        </p>
        <p>
            <label for="phone">Phone:</label>
            <input type="tel" id="phone" name="phone">
        </p>
        
        <p>
            <label for="email">email</label>
            <input type="email" id="email" name="email">
        </p>
        
        <p>
            <label for="intruction">delivery instruction:</label>
            <textarea 
            id="Instruction"
            name="intruction"
            rows="4"
            cols="50"
            maxlength="400"
            placeholder="no more than 400 character.">
            </textarea>
        </p>
      </fieldset>
      
      <fieldset>
             <legend>design your dream pizza</legend>
             <p>pizza specs</p>
             <p>pilih 1:</p>
             
             <p>
                <input type="radio" id="classic"name="crust"value="classic white">
                <label for="classic">classic white</label><br>
                
                   <input type="radio" id="multigrain"name="crust"value="multigrain">
                <label for="multigrain">multigrain</label><br>
                
                   <input type="radio" id="Cheese"name="crust"value="Cheese">
                <label for="cheese">cheese</label><br>
                
                   <input type="radio" id="gluten"name="crust"value="gluten">
                <label for="gluten">gluten</label><br>
             </p>
             <p>toping</p>
                <input type="checkbox" id="redsauce"name="toppings"value="redsauce" checked>
                <label for="redsauce">Red sauce</label><br>
                
                 <input type="checkbox" id="White sauce"name="toppings"value="White sauce" checked>
                <label for="White sauce">White sauce</label><br>
                
                 <input type="checkbox" id="Mozzarella Cheese"name="toppings"value="Mozzarella" checked>
                <label for="Mozzarella cheese">Mozzarella cheese</label><br>
                
                 <input type="checkbox" id="Pepperoni"name="toppings"value="Pepperoni" checked>
                <label for="Pepperoni">Pepperoni</label><br>
                
                 <input type="checkbox" id="Mushrooms"name="toppings"value="Mushrooms" checked>
                <label for="Mushrooms">Mushrooms</label><br>
                
                 <input type="checkbox" id="Peppers"name="toppings"value="Peppers" checked>
                <label for="Peppers">Peppers</label><br>
                
                 <input type="checkbox" id="Anchovies"name="toppings"value="Anchovies" checked>
                <label for="Anchovies">Anchovies</label><br>
             </p>
             
             <p> 
               <label for="quantity">quantity</label>
               <input type="number" id="quantity"
               name="quantity" min="1" max="10"
              </p>
       </fieldset>
       <p>
          <input type="submit" value="submit">
          <input type="reset" value="reset ">
       </p>
    </form>
</body>

</html>